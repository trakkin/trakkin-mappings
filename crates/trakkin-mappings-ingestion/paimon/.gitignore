######################################################################################################
# https://github.com/github/gitignore/blob/e111f1c746c268ced3d202c2a0192cf0c9d39b01/Java.gitignore   #
######################################################################################################
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
